---
title: Fleet, smart tins and field operations
---
erDiagram
    ADDRESS ||--o{ COUNCIL_FACILITY : "address_id"
    ADDRESS ||--o| DEPOT : "address_id"
    DEPOT |o--o{ VEHICLE : "depot_id"
    OUTSOURCE_SUPPLIER |o--o{ VEHICLE : "supplier_id"
    VEHICLE ||--o{ VEHICLE_MAINTENANCE : "vehicle_id"
    TIN_SIZE ||--o{ SMART_TIN : "tin_size_id"
    DEPOT ||--o{ SMART_TIN : "depot_id"
    SMART_TIN ||--o{ TIN_TELEMETRY : "tin_id"
    DEPOT |o--o{ STAFF : "depot_id"
    OUTSOURCE_SUPPLIER |o--o{ STAFF : "supplier_id"
    ADDRESS |o--o{ STAFF : "address_id"
    SMART_TIN |o--o{ ORDER_LINE : "tin_id, tin_size_id"
    VEHICLE ||--o{ JOB : "vehicle_id"
    JOB ||--o{ JOB_STAFF : "job_id"
    STAFF ||--o{ JOB_STAFF : "staff_id"
    ORDER_LINE ||--o{ DISPOSAL_RECORD : "order_line_id"
    JOB ||--o{ DISPOSAL_RECORD : "job_id"
    COUNCIL_FACILITY ||--o{ DISPOSAL_RECORD : "facility_id"
    OUTSOURCE_SUPPLIER ||--o{ SUPPLIER_INVOICE : "supplier_id"
    ADDRESS {
        number address_id PK "not null"
        varchar2 street_line1 "(150) not null"
        varchar2 street_line2 "(150) null"
        varchar2 suburb "(80) not null"
        varchar2 state_code FK "(3) not null"
        varchar2 postcode "(4) not null"
        number council_id FK "not null"
        number latitude "(9,6) null"
        number longitude "(9,6) null"
    }
    COUNCIL_FACILITY {
        number facility_id PK "not null"
        number council_id FK "not null"
        number address_id FK "not null"
        varchar2 facility_name "(120) not null"
        varchar2 facility_type "(10) not null"
        number gate_fee_per_tonne "(10,2) not null"
        varchar2 operating_hours "(100) null"
        number is_active "(1) not null"
    }
    TIN_SIZE {
        number tin_size_id PK "not null"
        varchar2 size_code UK "(10) not null"
        number volume_m3 UK "(4,1) not null"
        number max_load_kg "(8) not null"
        varchar2 description "(200) null"
    }
    DEPOT {
        number depot_id PK "not null"
        number address_id FK,UK "not null"
        varchar2 depot_name UK "(100) not null"
        varchar2 phone "(20) null"
    }
    OUTSOURCE_SUPPLIER {
        number supplier_id PK "not null"
        varchar2 supplier_name "(120) not null"
        varchar2 abn UK "(11) not null"
        varchar2 contact_name "(100) null"
        varchar2 contact_email "(150) null"
        varchar2 contact_phone "(20) null"
        number daily_vehicle_rate "(10,2) not null"
        number hourly_staff_rate "(10,2) not null"
        date contract_start "not null"
        date contract_end "null"
        varchar2 supplier_status "(10) not null"
    }
    VEHICLE {
        number vehicle_id PK "not null"
        varchar2 registration_no UK "(10) not null"
        varchar2 vehicle_type "(15) not null"
        varchar2 make "(50) not null"
        varchar2 model "(50) not null"
        number year_built "(4) not null"
        number capacity_tonnes "(5,2) not null"
        varchar2 ownership "(10) not null"
        number depot_id FK "null"
        number supplier_id FK "null"
        varchar2 vehicle_status "(15) not null"
        date next_service_due "null"
    }
    VEHICLE_MAINTENANCE {
        number maintenance_id PK "not null"
        number vehicle_id FK "not null"
        date service_date "not null"
        varchar2 maintenance_type "(15) not null"
        number odometer_km "(8) not null"
        number cost "(10,2) not null"
        varchar2 notes "(300) null"
    }
    SMART_TIN {
        number tin_id PK "not null"
        varchar2 tin_serial UK "(20) not null"
        number tin_size_id FK "not null"
        number depot_id FK "not null"
        varchar2 device_imei UK "(15) not null"
        varchar2 firmware_version "(20) null"
        varchar2 tin_status "(12) not null"
        date purchase_date "not null"
        timestamp last_seen_at "null"
    }
    TIN_TELEMETRY {
        number telemetry_id PK "not null"
        number tin_id FK "not null"
        timestamp recorded_at "not null"
        number fill_level_pct "(5,2) not null"
        number weight_kg "(8,2) not null"
        number latitude "(9,6) null"
        number longitude "(9,6) null"
        number battery_pct "(5,2) null"
        number tamper_flag "(1) not null"
    }
    STAFF {
        number staff_id PK "not null"
        varchar2 employment_type "(10) not null"
        number depot_id FK "null"
        number supplier_id FK "null"
        number position_id FK "not null"
        number address_id FK "null"
        varchar2 first_name "(60) not null"
        varchar2 last_name "(60) not null"
        date date_of_birth "not null"
        varchar2 email UK "(150) not null"
        varchar2 phone "(20) null"
        varchar2 licence_no UK "(20) null"
        varchar2 licence_class "(5) null"
        date licence_expiry "null"
        date hire_date "not null"
        date termination_date "null"
        number hourly_rate "(8,2) not null"
        varchar2 staff_status "(10) not null"
    }
    ORDER_LINE {
        number order_line_id PK "not null"
        number order_id FK "not null"
        number category_id FK "not null"
        number tin_size_id FK "not null"
        number tin_id FK "null"
        number unit_price "(10,2) not null"
    }
    JOB {
        number job_id PK "not null"
        number order_id FK "not null"
        number vehicle_id FK "not null"
        varchar2 job_type "(10) not null"
        timestamp scheduled_start "not null"
        timestamp actual_start "null"
        timestamp actual_end "null"
        varchar2 job_status "(12) not null"
        number outsource_cost "(10,2) not null"
        varchar2 notes "(300) null"
    }
    JOB_STAFF {
        number job_id PK,FK "not null"
        number staff_id PK,FK "not null"
        varchar2 job_role "(10) not null"
    }
    DISPOSAL_RECORD {
        number disposal_id PK "not null"
        number order_line_id FK "not null"
        number job_id FK "not null"
        number facility_id FK "not null"
        varchar2 docket_number UK "(20) not null"
        timestamp disposed_at "not null"
        number gross_weight_kg "(10,2) not null"
        number recycled_weight_kg "(10,2) not null"
        number gate_fee "(10,2) not null"
    }
    SUPPLIER_INVOICE {
        number supplier_invoice_id PK "not null"
        number supplier_id FK "not null"
        varchar2 supplier_ref "(30) not null"
        date period_start "not null"
        date period_end "not null"
        number subtotal "(12,2) not null"
        number gst_amount "(12,2) not null"
        number total_amount "(12,2) not null"
        date due_date "not null"
        date paid_date "null"
        varchar2 invoice_status "(10) not null"
    }
