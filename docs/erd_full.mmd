    STATE {
        varchar2 state_code PK "(3) not null"
        varchar2 state_name UK "(50) not null"
    }
    COUNCIL {
        number council_id PK "not null"
        varchar2 state_code FK "(3) not null"
        varchar2 council_name "(120) not null"
        varchar2 contact_email "(150) null"
        varchar2 contact_phone "(20) null"
        number waste_levy_per_tonne "(10,2) not null"
    }
    ADDRESS {
        number address_id PK "not null"
        varchar2 street_line1 "(150) not null"
        varchar2 street_line2 "(150) null"
        varchar2 suburb "(80) not null"
        varchar2 state_code FK "(3) not null"
        varchar2 postcode "(4) not null"
        number council_id FK "not null"
        number latitude "(9,6) null"
        number longitude "(9,6) null"
    }
    WASTE_CATEGORY {
        number category_id PK "not null"
        varchar2 category_code UK "(10) not null"
        varchar2 category_name "(60) not null"
        varchar2 weight_class "(5) not null"
        varchar2 description "(300) null"
    }
    COUNCIL_FACILITY {
        number facility_id PK "not null"
        number council_id FK "not null"
        number address_id FK "not null"
        varchar2 facility_name "(120) not null"
        varchar2 facility_type "(10) not null"
        number gate_fee_per_tonne "(10,2) not null"
        varchar2 operating_hours "(100) null"
        number is_active "(1) not null"
    }
    FACILITY_ACCEPTED_CATEGORY {
        number facility_id PK,FK "not null"
        number category_id PK,FK "not null"
    }
    TIN_SIZE {
        number tin_size_id PK "not null"
        varchar2 size_code UK "(10) not null"
        number volume_m3 UK "(4,1) not null"
        number max_load_kg "(8) not null"
        varchar2 description "(200) null"
    }
    CATEGORY_TIN_SIZE {
        number category_id PK,FK "not null"
        number tin_size_id PK,FK "not null"
    }
    TIN_PRICE {
        number tin_price_id PK "not null"
        number category_id FK "not null"
        number tin_size_id FK "not null"
        varchar2 state_code FK "(3) not null"
        number hire_price "(10,2) not null"
        date effective_from "not null"
    }
    DEPOT {
